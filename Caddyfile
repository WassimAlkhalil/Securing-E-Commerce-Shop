# Added Caddy configuration file for HTTPS reverse proxy
# @author: Nebil Müren - cas3322

# Redirect to HTTPS on ports 80 (http)
:80 {
    redir https://localhost{uri} permanent
}

# HTTPS server on port 443
localhost:443 {
    # Use self-signed certificate
    tls internal
    
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # author: Wassim Alkhalil
        # added google recaptcha to the content security policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https:; img-src 'self' data: https: http:; frame-src https://www.google.com; connect-src 'self' https://www.google.com"
    }
    
    # Reverse proxy to web app
    reverse_proxy web:5000 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}

